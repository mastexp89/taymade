# Copy this file to `.env` (next to docker-compose.yml) on the VPS and fill it in.
#   cp .env.docker.example .env && nano .env

# A strong Postgres password (make one up — letters+numbers, no spaces/quotes)
DB_PASSWORD=change-me-to-a-strong-password

# Session signing secret. Generate with:  openssl rand -hex 32
AUTH_SECRET=paste-a-64-char-hex-string-here

# Optional. Set once you know it, e.g. http://123.45.67.89  (or your domain later)
SITE_URL=

# Leave false on plain HTTP. Set to true ONLY after HTTPS is set up (a domain + cert),
# otherwise the login cookie gets dropped and you can't sign in.
COOKIE_SECURE=false

# How the app binds. Default (localhost:8090) sits behind nginx. Set WEB_BIND=80 to
# publish directly on port 80 instead (only if nothing else uses it).
WEB_BIND=127.0.0.1:8090
